# The one place the box's address and paths are written down.
#
# Sourced by test-box.sh (and by the runner scripts in /home/jx/Phi that have
# not been folded into it yet). Lane 6 §6 item 6 counted the same four values
# repeated across four scripts and seventeen test files; everything now reads
# them from here, and a second box needs one edited file.
#
# Override any of these in the environment: `PHI_BOX_HOST=... ./test-box.sh`.

# ssh target. Key-based auth only — every ssh here runs with BatchMode=yes.
PHI_BOX_HOST="${PHI_BOX_HOST:-jdxin@192.168.100.170}"

# Where the local framework build lands; the exe whose hash must match on the
# box before a single test runs.
PHI_OUT_DIR="${PHI_OUT_DIR:-/home/jx/Phi/chromuim/src/out/PhiFxWin}"

# Box-side paths.
PHI_BOX_HOME="${PHI_BOX_HOME:-C:\\Users\\jdxin}"
PHI_BOX_DEPLOY="${PHI_BOX_DEPLOY:-C:\\Users\\jdxin\\phi-fx-dev}"
PHI_TEST_DIR="${PHI_TEST_DIR:-C:\\Users\\jdxin\\phitest}"

# The profile under test. phi-test.mjs discovers the control pipe in here and
# test/lib/box.mjs resolves profile paths against it, both through
# PHI_USER_DATA_DIR, so all three agree by construction.
#
# It is a FIXED path on purpose: the box's PhiFxLaunch scheduled task names it
# on the command line, and the task definition lives on the box, not in this
# repo (lane 6 §6 item 13). Isolation therefore resets the CONTENTS of this
# directory between suites rather than handing out a new path.
PHI_USER_DATA_DIR="${PHI_USER_DATA_DIR:-C:\\phi-fx-test}"

# The golden profile --isolation=golden copies from. Built on first use from
# one clean launch: a settled first-run profile, prefs already seeded.
PHI_GOLDEN_DIR="${PHI_GOLDEN_DIR:-C:\\phi-fx-golden}"

# The scheduled task that launches the client (it, not this script, owns the
# command line, including --user-data-dir).
PHI_LAUNCH_TASK="${PHI_LAUNCH_TASK:-PhiFxLaunch}"

# Ceilings, in seconds.
PHI_SUITE_TIMEOUT="${PHI_SUITE_TIMEOUT:-300}"   # per suite
PHI_LAUNCH_TIMEOUT="${PHI_LAUNCH_TIMEOUT:-90}"  # cold start to a live pipe
